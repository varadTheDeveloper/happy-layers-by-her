---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---

<Base title="Page not found" description="This page doesn’t exist.">
  <section class="wrap nf">
    <Logo class="nf-logo" text={false} />
    <h1>This page isn’t on the menu</h1>
    <p class="lede">The link may be old or mistyped.</p>
    <div class="btn-row">
      <a class="btn" href="/">Go to the home page</a>
      <a class="btn btn-ghost" href="/menu/">See the menu</a>
    </div>
  </section>
</Base>

<style>
  .nf { text-align: center; padding-block: clamp(56px, 10vw, 120px); }
  .nf :global(.nf-logo) { width: 120px; margin: 0 auto 24px; }
  .nf h1 { font-size: clamp(2rem, 1.4rem + 2.5vw, 3rem); }
  .nf .btn-row { justify-content: center; }
</style>
