---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import images from '../data/images.json';
import { gallery, galleryGroups } from '../data/content';
import { site } from '../data/site';

const big = (name: string) => {
  const e = (images as Record<string, { files: Record<string, string> }>)[name];
  const files = Object.values(e.files);
  return `/img/${files[files.length - 1]}`;
};
---

<Base title="Gallery" description="Photos of custom eggless cakes by Sneha: floral, vintage piping, theme cakes, tiered wedding cakes, bento cakes, desserts and hampers.">
  <PageIntro title="Gallery" lede="A few of the cakes and desserts Sneha has made. Like a design? Send the photo with your order and she’ll make it your way.">
    <div class="filters" role="group" aria-label="Filter photos">
      <button type="button" class="chip" aria-pressed="true" data-filter="all">All</button>
      {galleryGroups.map((g) => <button type="button" class="chip" aria-pressed="false" data-filter={g.id}>{g.label}</button>)}
    </div>
  </PageIntro>

  <section class="wrap">
    <ul class="masonry" role="list">
      {
        gallery.map((g) => (
          <li data-group={g.group}>
            <button type="button" class="open" data-full={big(g.img)} data-alt={g.alt} aria-label={`Enlarge: ${g.alt}`}>
              <Img name={g.img} alt={g.alt} sizes="(min-width: 1100px) 270px, (min-width: 700px) 33vw, 50vw" />
            </button>
          </li>
        ))
      }
    </ul>
    <p class="more muted">More every week on <a href={site.social.instagram}>Instagram {site.social.instagramHandle}</a>.</p>
  </section>

  <dialog class="lightbox" aria-label="Photo">
    <button type="button" class="close" aria-label="Close"><Icon name="close" /></button>
    <img alt="" />
    <p class="cap"></p>
    <a class="btn" href="/order/">Order something like this</a>
  </dialog>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLLIElement>('.masonry li');
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      const f = c.dataset.filter;
      items.forEach((li) => (li.hidden = f !== 'all' && li.dataset.group !== f));
    }),
  );

  const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dlg.querySelector('img')!;
  const cap = dlg.querySelector<HTMLElement>('.cap')!;
  document.querySelectorAll<HTMLButtonElement>('.open').forEach((b) =>
    b.addEventListener('click', () => {
      img.src = b.dataset.full!;
      img.alt = b.dataset.alt!;
      cap.textContent = b.dataset.alt!;
      dlg.showModal();
    }),
  );
  dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .chip {
    font: 600 0.95rem var(--body);
    padding: 9px 16px;
    min-height: 42px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
  }
  .chip[aria-pressed='true'] { background: var(--rose); border-color: var(--rose); color: #fff; }
  .masonry { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
  .masonry li[hidden] { display: none; }
  .open { display: block; width: 100%; aspect-ratio: 4 / 5; padding: 0; border: 0; background: var(--blush-soft); border-radius: 14px; overflow: hidden; cursor: zoom-in; }
  .open :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .open:hover :global(img) { transform: scale(1.03); }
  .more { text-align: center; padding: 28px 0 clamp(56px, 8vw, 96px); }
  @media (max-width: 560px) { .masonry { grid-template-columns: 1fr 1fr; gap: 10px; } }

  .lightbox { border: 0; padding: 16px; border-radius: 18px; max-width: min(92vw, 640px); background: var(--sugar); text-align: center; }
  .lightbox::backdrop { background: rgba(43, 31, 35, 0.75); }
  .lightbox img { max-height: 72vh; width: auto; margin: 0 auto 10px; border-radius: 12px; }
  .cap { color: var(--muted); font-size: var(--t-sm); }
  .close { position: absolute; top: 10px; right: 10px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: #fff; display: grid; place-items: center; cursor: pointer; }
  .close :global(svg) { width: 22px; height: 22px; }
</style>
